# Valores PENDIENDTE: sustituye cada uno en tu entorno local y en Vercel.
# La aplicación no acepta este marcador como credencial configurada.

# URL pública exacta del sitio, sin ruta ni barra final.
APP_ORIGIN=PENDIENDTE

# Configuración web de Firebase (Firebase Console > Project settings > General).
NEXT_PUBLIC_FIREBASE_API_KEY=PENDIENDTE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=PENDIENDTE
NEXT_PUBLIC_FIREBASE_PROJECT_ID=PENDIENDTE
NEXT_PUBLIC_FIREBASE_APP_ID=PENDIENDTE
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PENDIENDTE

# Cuenta de servicio privada para Firebase Admin. No publiques estos valores.
FIREBASE_ADMIN_PROJECT_ID=PENDIENDTE
FIREBASE_ADMIN_CLIENT_EMAIL=PENDIENDTE
FIREBASE_ADMIN_PRIVATE_KEY=PENDIENDTE

# Cloudflare Turnstile: site key pública y secret key solo del servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=PENDIENDTE
TURNSTILE_SECRET_KEY=PENDIENDTE

# Upstash Redis REST es obligatorio en producción para rate limits compartidos.
UPSTASH_REDIS_REST_URL=PENDIENDTE
UPSTASH_REDIS_REST_TOKEN=PENDIENDTE

# Opcional: direcciones IPv4/IPv6 exactas separadas por coma para bloquear.
BLOCKED_IPS=PENDIENDTE

# Opcional detrás de Cloudflare: secreto privado de al menos 32 caracteres.
# Cloudflare debe sobrescribir x-bandmaid-origin con este secreto y
# x-bandmaid-client-ip con to_string(ip.src) mediante Request Header Transform Rules.
CLOUDFLARE_ORIGIN_SECRET=PENDIENDTE
